{
  "name": "motrain",
  "version": "0.0.0",
  "description": "A fitness tracking application for recording workouts, tracking progress, and achieving health goals",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run -F backend dev",
    "lint": "turbo run lint && eslint eslint.config.js",
    "lint:backend": "turbo run -F backend lint",
    "check-types": "turbo run check-types",
    "check-types:backend": "turbo run -F backend check-types"
  },
  "keywords": [
    "fitness",
    "workout",
    "health",
    "tracking"
  ],
  "author": "Evan",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.4.1",
    "eslint-plugin-turbo": "2.9.16",
    "globals": "17.6.0",
    "turbo": "2.9.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
