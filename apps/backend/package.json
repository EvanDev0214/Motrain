{
  "name": "backend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "db:generate": "read -p 'Migration name: ' name && drizzle-kit generate --name=$name",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "author": "Evan",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "argon2": "0.44.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-basic-auth": "1.2.1",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.21.0",
    "pg-error-enum": "2.0.1",
    "pino-http": "11.0.0",
    "resend": "6.12.4",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.31.10",
    "openapi3-ts": "4.6.0",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.22.4"
  }
}
