{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "PORT",
    "HOST",
    "NODE_ENV",
    "DATABASE_URL",
    "CORS_ORIGIN",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "RESEND_OTP_EXPIRES_MINUTES",
    "MAX_OTP_ATTEMPTS",
    "SWAGGER_USER",
    "SWAGGER_PASSWORD",
    "JWT_ACCESS_SECRET_KEY",
    "JWT_REFRESH_SECRET_KEY",
    "JWT_PASSWORD_RESET_SECRET_KEY",
    "JWT_ACCESS_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "JWT_PASSWORD_RESET_EXPIRES_IN",
    "JWT_ISS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
