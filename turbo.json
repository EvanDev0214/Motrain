{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "PORT",
    "HOST",
    "NODE_ENV",
    "DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
